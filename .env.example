# Settings for a MASTER node or a single-server ("both") install.
# install.sh writes .env for you; this file documents what is in it.
# A slave node has a much smaller .env, also written by install.sh
# (see docs/CONFIGURATION.md).

# What this server is: master | both. Decides which services start.
ROLE=both
# master -> master            both -> master,local-engine
COMPOSE_PROFILES=master,local-engine
# The engine on this same server; leave empty on a master-only install.
LOCAL_ENGINE=audio_engine:3000

# Where the service images come from. Prebuilt images are downloaded from the
# registry below; INSTALL_FROM=source compiles them on this server instead
# (needs about 2 GB of memory and several minutes).
INSTALL_FROM=images
IMAGE_PREFIX=ghcr.io/blacdev/streamnode
# "latest", or a released version such as v2.4.0 to stay on it.
IMAGE_TAG=latest

# Public hostname of the gateway, e.g. stream.example.com. Point its DNS record
# straight at this server (not through a caching proxy/CDN). Without a domain
# the installer puts this server's IP address here instead.
DOMAIN=stream.example.com
# Origin used in stream URLs and in the install command given to slave nodes.
# Empty: taken from each request. Requests made to the server's IP address
# always get URLs on that address, whatever is set here.
PUBLIC_BASE_URL=https://stream.example.com
# true redirects the dashboard and API to HTTPS when they are asked for by the
# domain name. Requests to the server's IP address are served as they come.
FORCE_HTTPS=true

# Where the domain's certificate comes from:
#   letsencrypt  obtained and renewed by scripts/letsencrypt.sh
#   provided     your own certificate in certs/stream.pem
#   external     a load balancer or proxy in front of this server handles HTTPS
#                and forwards plain HTTP to it
#   selfsigned   a temporary certificate, for testing
TLS_MODE=selfsigned

# Host ports published by HAProxy, and the address they are published on.
# 0.0.0.0 is every network interface: local network and internet alike.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Address the HTTPS port is published on. 127.0.0.1 with TLS_MODE=external,
# where nothing listens on it.
HTTPS_BIND=0.0.0.0

# PostgreSQL credentials (internal network only).
POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gateway_management

# Redis password. Slave nodes receive it when they join.
REDIS_PASSWORD=change-me
# Secret HAProxy sends to every engine, so engines accept listeners only
# through this gateway. Slave nodes receive it when they join.
ENGINE_SECRET=change-me

# Where slave nodes reach Redis (TLS, through HAProxy). 0.0.0.0 on a master
# that has slave nodes; 127.0.0.1 keeps it closed on a single server.
CLUSTER_BIND=127.0.0.1
CLUSTER_PORT=6380
# Address slave nodes use to reach this server directly, if the domain points
# at something in front of it. Empty: they use the domain.
CLUSTER_HOST=
# Certificate presented on that Redis port, as a path inside the HAProxy
# container. Empty: this server takes no slave nodes.
CLUSTER_CERT=/etc/haproxy/certs/stream.pem

# Operator sign-in for the dashboard, and the bootstrap API key for integrations.
# The key must start with rgw_ and be at least 36 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_API_KEY=rgw_change-me-change-me-change-me-change-me

# Browser origins allowed to call the authenticated API (comma-separated, or *).
# Leave empty when only servers call the API.
CORS_ORIGINS=

# How many stations a new tenant account may create and manage on its own.
DEFAULT_MAX_STATIONS=5

# Uploaded audio (idents and fallback files). Once Dropbox is connected in the
# dashboard, files are kept there and this much, in megabytes, is kept on the
# server for quick access. Without Dropbox every file stays on the server.
# Quotas per account and the ident length are set in the dashboard (Settings).
FILE_CACHE_MB=2048

# Let stations use sources on private/loopback addresses. Keep false in
# production. Slave nodes follow the master's setting.
ALLOW_PRIVATE_SOURCES=false

# Engine tuning for the engine on this server (seconds unless noted).
IDLE_GRACE_SECS=10
STALL_TIMEOUT_SECS=10
PRIMARY_RETRY_SECS=30
METADATA_POLL_SECS=10
BURST_BYTES=65536

# History kept at minute/hour resolution; daily totals are kept forever.
STATS_MINUTE_RETENTION_DAYS=90

# Optional edge servers (docs/SCALING.md): private address for their relay port.
RELAY_BIND=127.0.0.1
RELAY_PORT=8444

# Only needed for scripts/letsencrypt.sh.
LETSENCRYPT_EMAIL=
