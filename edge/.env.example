# Copy to edge/.env on the edge server. An edge server is an optional, advanced
# addition: a second public entry point for the same domain (docs/SCALING.md).

# A unique name for this server. Use the same name when registering it on the master.
NODE_ID=edge-2

# Redis on the master, over TLS: rediss://:<REDIS_PASSWORD>@<master domain>:<CLUSTER_PORT>
REDIS_URL=rediss://:change-me@stream.example.com:6380
# ENGINE_SECRET from the master's .env.
ENGINE_SECRET=

# PRIVATE address of the master (RELAY_BIND in the master's .env) and its relay port.
GATEWAY_PRIVATE_HOST=10.0.0.1
GATEWAY_RELAY_PORT=8444

# Public ports of this edge server.
HTTP_PORT=80
HTTPS_PORT=443

# For sync-cert.sh: where to copy the certificate from, over SSH.
CERT_SOURCE=root@10.0.0.1:/opt/radio-gateway/certs/stream.pem

# Keep the same values as on the master.
ALLOW_PRIVATE_SOURCES=false
FORCE_HTTPS=true
